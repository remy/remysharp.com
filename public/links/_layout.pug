extends /_partials/layout

block meta
  link(rel="canonical" href=`https://remysharp.com${url}`)
  meta(name="og:title" content=`${title}`)
  meta(name="og:type" content="article")
  meta(name="og:site_name" content="Remy's b:log")
  meta(name="og:image" content=`https://remysharp.com/images/cards/${moment(data.date).modDOY(9)}.jpg`)

block content
  - permalink = url;
  - safeTitle = data.title.replace(/'/g, '\\\'')
  - renderedContent = (yield || '').replace(/<p><em>Source:[\s\S]*?<\/em><\/p>\s*$/i, '').replace(/<p><em>Original link:[\s\S]*?<\/em><\/p>\s*$/i, '')

  main.content
    article.post.h-entry.link-post
      h1.title.p-name
        a(href=`${data.url}` title=`Permanent Link: ${title}`).u-url.u-uid= `Bookmark: ${title}`

      .post-content.e-content
        != renderedContent

        footer
          p
            strong Original link:
            br
            a.bookmark.link(href=`${data.url}` title=`${title}`).u-url.u-uid= compressUrl(data.url)

      .misc-content
        p.metadata
          a(href="/links/") Discover more links
          br
          span Saved <time class="dt-published" datetime="#{ moment(date).format('yyyy-MM-dd HH:mm:ss') }">#{moment(date).format('d-MMM yyyy')}</time> under ##{(tags || []).join(' & #')}. <a target="_blank" rel="noopener" href="https://github.com/remy/remysharp.com/blob/main/public/links/#{current.source}.md">Edit this post</a>
