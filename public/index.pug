- latest = collections.latest
- book = collections.currentlyReading[0]

h1.title
  img.icon.photo(alt="Remy Sharp's blog" src="/images/avatar-2022-square.avif" height=50 width=50)
  | &nbsp;Welcome!

.post-content.addr
  :marked
    Hello and welcome to my <a class="url" href="/">b:log</a>. I'm <span class="fn n">Remy Sharp</span>, a developer running my own business called <a class="org url" href="http://leftlogic.com">Left Logic</a> out of <span class="locality">Brighton</span>, <abbr title="United Kingdom">UK</abbr>. This place will mostly concentrate on [web](/tag/web/), [code](/tag/code/), a touch of [business](/tag/business/) and some other [personal pieces](/tag/personal/) too - all available here or as a friendly [RSS feed](/feeds). Enjoy!

article.post
  header.post-header
    h2.title
      a(href=`${latest.url}`) Latest: #{ latest.data.title }
  section.post-excerpt.post-content
    - content = latest.output;

    if content.split(/<!--\s*more\s*-->/).length > 1
      != content.split(/<!--\s*more\s*-->/)[0].replace(/<h1>.*?<\/h1>/, '').trim()
    else if content.split('<hr>').length > 1
      != content.split('<hr>')[0].replace(/<h1>.*?<\/h1>/, '').trim()
    else
      != content.split('<p>').slice(0, 4).join('<p>').replace(/<h1>.*?<\/h1>/, '').trim()
    p
      a(href=`${latest.url}`) Read the rest of this entry &raquo;

section.post.lists
  header.post-header
    h2.title Recently Updated
  .post-content
    ul
      each post in collections.recent
        li
          a(href=`${ post.url }`)= post.data.title
          small &nbsp; updated #{ moment(post.data.modified).format('d-MMM yyyy') }

section.post.lists#elsewhere
  header.post-header
    h2.title Remy Elsewhere
  .post-content
    ul.links
      li
        a(href="https://leftlogic.com" rel="me" title="my business: hire me") Left Logic
        | &nbsp;- my business: hire me
      li
        a(href="https://github.com/remy/" rel="me" title="Fork me!") @remy on Github
        | &nbsp;- fork me!
      li
        a(href="https://bsky.app/profile/remysharp.com" rel="me" title="bloot, bloot") @rem on Bluesky
        | &nbsp;- bloot, bloot
      li
        a(href="https://front-end.social/@rem" rel="me" title="toot, toot") @rem on Mastodon
        | &nbsp;- toot, toot
      li
        a(href="/books" rel="me" title="some for fun, some for geek") Reading
        | &nbsp;- ssssssh
      //- li
      //-   a(href="https://www.twitch.tv/remysharp" rel="me" title="link goodness") Streaming
      //-   | &nbsp;- bug squishing live
      li
        a(href="/links" title="link goodness") Bookmarks
        | &nbsp;- linky goodness
      li
        a(href="https://flickr.com/photos/remysharp" rel="me" title="some for fun, some for geek") Flickr
        | &nbsp;- some for fun, some for geek
      //- li
        a(href="http://jqueryfordesigners.com" rel="me" title="tutorials &amp; screencasts") jQuery for Designers
        | &nbsp;- tutorials &amp; screencasts
      //- li
        a(href="http://www.ihatemusic.com" rel="me" title="old skool palm apps") Palm Apps
        | &nbsp;- old skool palm apps
      li
        a(href="/speaking/" rel="me" title="my conf talks") Speaking
        | &nbsp;- my conf talks
    div#currently
      #currentlyReading
        h3 Reading
        .track
          div.cover
            img(width="64" src=`${book.cover}`)
          p
            span.title= book.title
            span.by By #{book.author}

      #recentlyListening
        script(src="/js/spin.mjs")

      #currentlyLinking
        h3 Linking
        div
          p
            a.title(href=`${collections.links[0].url}`)= collections.links[0].data.title
            span.by By&nbsp;
              a.by(href=`${collections.links[0].data.url}`)= collections.links[0].data.url.split('/')[2]