extends /_partials/layout

block meta
  link(rel="canonical" href=`https://remysharp.com${url}`)
  meta(name="og:image" content=`https://remysharp.com/images/books/${id || goodreads_id}.avif`)
  meta(name="og:title" content=`${title}`)
  meta(name="og:description" content=`(${rating}/5) ${summary}`)
  meta(name="description" content=`(${rating}/5) ${summary}`)

block content
  - permalink = url;
  - otherBooks = seriesBooks(series, slug)

  main.content
    article.post.h-review
      h1.title.p-name
        a(href=`${url}` title=`Permanent Link: ${title}`).u-url.u-uid= `Review: ${title}`

      .misc-content.book-meta
        p.p-author.h-card
          strong Author
          | #{author}
        p
          strong Published
          | <time class="dt-published" datetime="#{moment(published).format('yyyy')}">#{published}</time>
        p.p-rating
          strong My rating
          span.rating(data-rating=`${ rating }` aria-label=`${ rating } stars out of 5` title=`${ rating } stars out of 5`)
            span #{rating} / 5
        p
          strong Read
          if Array.isArray(read)
            | <time datetime="#{moment(read).format('yyyy-MM-dd')}">#{read.map(_ => moment(_).format('MMMM yyyy')).join(', ')}</time>
          else
            | <time datetime="#{moment(read).format('yyyy-MM-dd')}">#{moment(read).format('MMMM yyyy')}</time>
        img.cover(src=`/images/books/${id || goodreads_id}.avif` width="64")

      .post-content.e-content
        if spoiler
          p
            strong This review includes spoilers, you've been forewarned.
          details
            summary #{summary}

            != yield

            if clippings
              h3 #{clippings.length} Highlight#{clippings.length === 1 ? '' : 's'}
              each clipping, index in clippings
                .clipping
                  p.clipping-meta ##{index + 1}/#{clippings.length} - Location #{clipping.location || clipping.page}
                  .clipping-text!= markdown(clipping.text)
                  if clipping.note && clipping.note.trim() !== 'null'
                    p.clipping-note
                      small My note: #{clipping.note}
        else
          != yield

          if clippings
            h3 #{clippings.length} Highlight#{clippings.length === 1 ? '' : 's'}
            each clipping, index in clippings
              .clipping
                p.clipping-meta ##{index + 1}/#{clippings.length} - Location #{clipping.location || clipping.page}
                .clipping-text!= markdown(clipping.text)
                if clipping.note && clipping.note.trim() !== 'null'
                  p.clipping-note
                    small My note: #{clipping.note}


        if otherBooks.length > 0
          p
            strong Others I've read in the "#{series}" series:
            ul
              each book in otherBooks
                li
                  a(href=`${filenameToUrl(book.filename)}` title=`${book.title}`)= book.title

      if date
        .misc-content
          p.metadata
            span Last read on <time datetime="#{ moment(lastDate(read)).format('yyyy-MM-dd HH:mm:ss') }">#{moment(lastDate(read)).format('d-MMM yyyy')}</time>, starting on <time datetime="#{ moment(lastDate(start)).format('yyyy-MM-dd HH:mm:ss') }">#{moment(lastDate(start)).format('d-MMM yyyy')}</time>, #{ pages } pages.<br>!{ goodreads ? ` | <a target="_blank" rel="noopener" href="${goodreads}">Goodreads page</a>` : '' }

            if identifiers
              p.metadata.elsewhere
                if identifiers.isbn
                  span ISBN #{identifiers.isbn}
                if identifiers.storygraph
                  span
                    a(target="_blank" rel="noopener" href=`https://app.thestorygraph.com/books/${identifiers.storygraph}`) Storygraph
                if identifiers.hardcover
                  span
                    a(target="_blank" rel="noopener" href=`https://hardcover.app/books/${identifiers.hardcover}`) Hardcover
                if identifiers.goodreads
                  span
                    a(target="_blank" rel="noopener" href=`https://www.goodreads.com/book/show/${identifiers.goodreads}`) Goodreads
