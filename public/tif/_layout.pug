extends /_partials/layout

block meta
  link(rel="canonical" href=`https://remysharp.com${url}`)
  meta(name="og:title" content=`${title}`)
  meta(name="og:type" content="article")
  meta(name="og:site_name" content="Remy's b:log")
  meta(name="og:image" content=`https://remysharp.com/images/cards/${moment(date).modDOY(9)}.jpg`)

block content
  - permalink = url;
  - safeTitle = title.replace(/'/g, '\\\'')

  main.content
    article.post.h-entry
      h1.title.p-name
        a(href=`${url}` title=`Permanent Link: ${title}`).u-url.u-uid= title

      .post-content.e-content
        != yield
        if photo
          img(src=`${photo}`)

      if date
        .misc-content
          p.metadata Fixed at <time class="dt-published" datetime="#{ moment(date).format('yyyy-MM-dd HH:mm:ss') }">#{moment(date).format('d-MMM yyyy @ HH:mm')}</time> about #{dirname}. <a target="_blank" rel="noopener" href="https://github.com/remy/remysharp.com/blob/main/#{current.inputPath}">Edit this post</a>
